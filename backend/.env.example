# App
APP_NAME="Multi-Agent Stock Research Analyst"
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (use SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./stock_research.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stock_research

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Market (NSE or BSE default)
DEFAULT_MARKET=NSE

# News RSS feeds (free - no API key needed)
NEWS_FEED_ET=https://economictimes.indiatimes.com/markets/stocks/rss.cms
NEWS_FEED_MINT=https://www.livemint.com/rss/markets

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
